{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "category",
    "failures",
    "status",
    "confidence",
    "reasoning"
  ],
  "properties": {
    "category": {
      "type": "string",
      "description": "Exactly one of \"ProductBug\", \"TestBug\", \"Flaky\", \"Environment\"."
    },
    "failures": {
      "type": "string",
      "description": "JSON array: test_id, category, evidence, suggested_fix."
    },
    "status": {
      "type": "string",
      "description": "\"success\", \"review\" or \"failure\"."
    },
    "confidence": {
      "type": "number",
      "description": "0.0-1.0 confidence in this result."
    },
    "reasoning": {
      "type": "string",
      "description": "One-paragraph explanation."
    }
  },
  "additionalProperties": false
}