<bpmndi:BPMNEdge id="F_G_CI_G_Join_di" bpmnElement="F_G_CI_G_Join"><di:waypoint x="1090" y="330"/><di:waypoint x="2000" y="330"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="F_G_CI_Triage_di" bpmnElement="F_G_CI_Triage"><di:waypoint x="1065" y="355"/><di:waypoint x="1065" y="520"/><di:waypoint x="1140" y="520"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="F_Triage_G_Cat_di" bpmnElement="F_Triage_G_Cat"><di:waypoint x="1250" y="520.0"/><di:waypoint x="1300" y="520.0"/></bpmndi:BPMNEdge>
