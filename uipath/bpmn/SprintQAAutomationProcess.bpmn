<bpmndi:BPMNEdge id="F_G_Cat_ReviewTriage_di" bpmnElement="F_G_Cat_ReviewTriage"><di:waypoint x="1325" y="545"/><di:waypoint x="1325" y="970"/><di:waypoint x="1400" y="970"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="F_ReviewTriage_G_Cat_di" bpmnElement="F_ReviewTriage_G_Cat"><di:waypoint x="1510" y="970"/><di:waypoint x="1540" y="970"/><di:waypoint x="1540" y="920"/><di:waypoint x="1280" y="920"/><di:waypoint x="1280" y="530"/><di:waypoint x="1303" y="530"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="F_BugReport_G_Sev_di" bpmnElement="F_BugReport_G_Sev"><di:waypoint x="1510" y="520.0"/><di:waypoint x="1560" y="520.0"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="F_G_Sev_ApproveBug_di" bpmnElement="F_G_Sev_ApproveBug"><di:waypoint x="1585" y="545"/><di:waypoint x="1585" y="670"/><di:waypoint x="1650" y="670"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="F_ApproveBug_CreateBug_di" bpmnElement="F_ApproveBug_CreateBug"><di:waypoint x="1760" y="670"/><di:waypoint x="1875" y="670"/><di:waypoint x="1875" y="555"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="F_G_Sev_CreateBug_di" bpmnElement="F_G_Sev_CreateBug"><di:waypoint x="1610" y="520.0"/><di:waypoint x="1820" y="520.0"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="F_CreateBug_G_Join_di" bpmnElement="F_CreateBug_G_Join"><di:waypoint x="1930" y="520"/><di:waypoint x="2025" y="520"/><di:waypoint x="2025" y="355"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="F_CreateTask_G_Join_di" bpmnElement="F_CreateTask_G_Join"><di:waypoint x="1510" y="820"/><di:waypoint x="2025" y="820"/><di:waypoint x="2025" y="355"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="F_G_Join_Notify_di" bpmnElement="F_G_Join_Notify"><di:waypoint x="2050" y="330.0"/><di:waypoint x="2100" y="330.0"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="F_Notify_End_di" bpmnElement="F_Notify_End"><di:waypoint x="2210" y="330.0"/><di:waypoint x="2270" y="330.0"/></bpmndi:BPMNEdge>
