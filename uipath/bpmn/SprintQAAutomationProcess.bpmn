<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs_SprintQAAutomationProcess" targetNamespace="http://bpmn.io/schema/bpmn">
<bpmn:process id="SprintQAAutomationProcess" name="Sprint QA Automation Process" isExecutable="true">
<bpmn:startEvent id="Start" name="Start (Manual / Every 2h)"><bpmn:documentation>Triggers: Manual + Orchestrator Time trigger every 2 hours.</bpmn:documentation><bpmn:outgoing>F_Start_FetchTickets</bpmn:outgoing></bpmn:startEvent>
<bpmn:serviceTask id="FetchTickets" name="Fetch Sprint QA Tickets"><bpmn:documentation>RPA Workflow to Fetch Sprint QA Tickets (REFramework dispatcher) -&gt; Queue QA_Tickets</bpmn:documentation><bpmn:incoming>F_Start_FetchTickets</bpmn:incoming><bpmn:outgoing>F_FetchTickets_TestDesign</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="TestDesign" name="Process Ticket for Test Design"><bpmn:documentation>Agent 1: Test Design &amp; Scaffold Agent</bpmn:documentation><bpmn:incoming>F_FetchTickets_TestDesign</bpmn:incoming><bpmn:outgoing>F_TestDesign_ApprovePR</bpmn:outgoing></bpmn:serviceTask>
<bpmn:userTask id="ApprovePR" name="Human Review: Approve Test PR"><bpmn:documentation>Action Center app: Approve Test PR</bpmn:documentation><bpmn:incoming>F_TestDesign_ApprovePR</bpmn:incoming><bpmn:outgoing>F_ApprovePR_G_PR</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="G_PR" name="PR Approved?" default="F_G_PR_CommitPR"><bpmn:incoming>F_ApprovePR_G_PR</bpmn:incoming><bpmn:outgoing>F_G_PR_CommitPR</bpmn:outgoing><bpmn:outgoing>F_G_PR_EndRejected</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="CommitPR" name="Commit Tests and Open PR"><bpmn:documentation>RPA Workflow to Commit Tests and Open PR (GitHub REST)</bpmn:documentation><bpmn:incoming>F_G_PR_CommitPR</bpmn:incoming><bpmn:outgoing>F_CommitPR_RunCI</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="RunCI" name="Trigger and Monitor CI"><bpmn:documentation>RPA Workflow to Trigger and Monitor CI (workflow_dispatch, poll, download results.json)</bpmn:documentation><bpmn:incoming>F_CommitPR_RunCI</bpmn:incoming><bpmn:outgoing>F_RunCI_G_CI</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="G_CI" name="CI Passed?" default="F_G_CI_Triage"><bpmn:incoming>F_RunCI_G_CI</bpmn:incoming><bpmn:outgoing>F_G_CI_G_Join</bpmn:outgoing><bpmn:outgoing>F_G_CI_Triage</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="Triage" name="Triage CI Failures"><bpmn:documentation>Agent 2: Failure Triage Agent (triage mode)</bpmn:documentation><bpmn:incoming>F_G_CI_Triage</bpmn:incoming><bpmn:outgoing>F_Triage_G_Cat</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="G_Cat" name="Triage Category" default="F_G_Cat_BugReport"><bpmn:incoming>F_Triage_G_Cat</bpmn:incoming><bpmn:incoming>F_ReviewTriage_G_Cat</bpmn:incoming><bpmn:outgoing>F_G_Cat_BugReport</bpmn:outgoing><bpmn:outgoing>F_G_Cat_CreateTask</bpmn:outgoing><bpmn:outgoing>F_G_Cat_ReviewTriage</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="BugReport" name="Prepare Bug Report"><bpmn:documentation>Agent 3: Bug Report Agent</bpmn:documentation><bpmn:incoming>F_G_Cat_BugReport</bpmn:incoming><bpmn:outgoing>F_BugReport_G_Sev</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="G_Sev" name="Severity S1/S2?" default="F_G_Sev_CreateBug"><bpmn:incoming>F_BugReport_G_Sev</bpmn:incoming><bpmn:outgoing>F_G_Sev_ApproveBug</bpmn:outgoing><bpmn:outgoing>F_G_Sev_CreateBug</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="ApproveBug" name="Human Review: Approve S1/S2 Bug"><bpmn:documentation>Action Center app: Approve S1/S2 Bug</bpmn:documentation><bpmn:incoming>F_G_Sev_ApproveBug</bpmn:incoming><bpmn:outgoing>F_ApproveBug_CreateBug</bpmn:outgoing></bpmn:userTask>
<bpmn:serviceTask id="CreateBug" name="Create Jira Bug and Update Sheet"><bpmn:documentation>RPA Workflow to Create Jira Bug and Update Bug Sheet</bpmn:documentation><bpmn:incoming>F_ApproveBug_CreateBug</bpmn:incoming><bpmn:incoming>F_G_Sev_CreateBug</bpmn:incoming><bpmn:outgoing>F_CreateBug_G_Join</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="CreateTask" name="Create Jira Task"><bpmn:documentation>RPA Workflow to Create Jira Bug and Update Bug Sheet (issueType=Task)</bpmn:documentation><bpmn:incoming>F_G_Cat_CreateTask</bpmn:incoming><bpmn:outgoing>F_CreateTask_G_Join</bpmn:outgoing></bpmn:serviceTask>
<bpmn:userTask id="ReviewTriage" name="Review Low-Confidence Triage"><bpmn:documentation>Action Center app: Review Low-Confidence Triage</bpmn:documentation><bpmn:incoming>F_G_Cat_ReviewTriage</bpmn:incoming><bpmn:outgoing>F_ReviewTriage_G_Cat</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="G_Join" name="Merge"><bpmn:incoming>F_G_CI_G_Join</bpmn:incoming><bpmn:incoming>F_CreateBug_G_Join</bpmn:incoming><bpmn:incoming>F_CreateTask_G_Join</bpmn:incoming><bpmn:outgoing>F_G_Join_Notify</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="Notify" name="Send Teams Notification"><bpmn:documentation>RPA Workflow to Send Teams Notification</bpmn:documentation><bpmn:incoming>F_G_Join_Notify</bpmn:incoming><bpmn:outgoing>F_Notify_End</bpmn:outgoing></bpmn:serviceTask>
<bpmn:endEvent id="End" name="End"><bpmn:incoming>F_Notify_End</bpmn:incoming></bpmn:endEvent>
<bpmn:endEvent id="EndRejected" name="Test PR Rejected"><bpmn:incoming>F_G_PR_EndRejected</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="F_Start_FetchTickets" sourceRef="Start" targetRef="FetchTickets"/>
<bpmn:sequenceFlow id="F_FetchTickets_TestDesign" sourceRef="FetchTickets" targetRef="TestDesign"/>
<bpmn:sequenceFlow id="F_TestDesign_ApprovePR" sourceRef="TestDesign" targetRef="ApprovePR"/>
<bpmn:sequenceFlow id="F_ApprovePR_G_PR" sourceRef="ApprovePR" targetRef="G_PR"/>
<bpmn:sequenceFlow id="F_G_PR_CommitPR" sourceRef="G_PR" targetRef="CommitPR" name="Approved"/>
<bpmn:sequenceFlow id="F_G_PR_EndRejected" sourceRef="G_PR" targetRef="EndRejected" name="Rejected"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">vars.approveTestPR.outcome == &quot;Reject&quot;</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F_CommitPR_RunCI" sourceRef="CommitPR" targetRef="RunCI"/>
<bpmn:sequenceFlow id="F_RunCI_G_CI" sourceRef="RunCI" targetRef="G_CI"/>
<bpmn:sequenceFlow id="F_G_CI_G_Join" sourceRef="G_CI" targetRef="G_Join" name="Yes"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">vars.ciResult.passed == true</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F_G_CI_Triage" sourceRef="G_CI" targetRef="Triage" name="No"/>
<bpmn:sequenceFlow id="F_Triage_G_Cat" sourceRef="Triage" targetRef="G_Cat"/>
<bpmn:sequenceFlow id="F_G_Cat_BugReport" sourceRef="G_Cat" targetRef="BugReport" name="ProductBug"/>
<bpmn:sequenceFlow id="F_G_Cat_CreateTask" sourceRef="G_Cat" targetRef="CreateTask" name="Flaky / TestBug"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">vars.triage.category == &quot;Flaky&quot; || vars.triage.category == &quot;TestBug&quot;</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F_G_Cat_ReviewTriage" sourceRef="G_Cat" targetRef="ReviewTriage" name="Confidence &lt; 0.7"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">vars.triage.confidence &lt; 0.7</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F_ReviewTriage_G_Cat" sourceRef="ReviewTriage" targetRef="G_Cat" name="Re-route with reviewer category"/>
<bpmn:sequenceFlow id="F_BugReport_G_Sev" sourceRef="BugReport" targetRef="G_Sev"/>
<bpmn:sequenceFlow id="F_G_Sev_ApproveBug" sourceRef="G_Sev" targetRef="ApproveBug" name="S1 / S2"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">vars.bugReport.severity == &quot;S1&quot; || vars.bugReport.severity == &quot;S2&quot;</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F_ApproveBug_CreateBug" sourceRef="ApproveBug" targetRef="CreateBug" name="Approved"/>
<bpmn:sequenceFlow id="F_G_Sev_CreateBug" sourceRef="G_Sev" targetRef="CreateBug" name="S3 / S4"/>
<bpmn:sequenceFlow id="F_CreateBug_G_Join" sourceRef="CreateBug" targetRef="G_Join"/>
<bpmn:sequenceFlow id="F_CreateTask_G_Join" sourceRef="CreateTask" targetRef="G_Join"/>
<bpmn:sequenceFlow id="F_G_Join_Notify" sourceRef="G_Join" targetRef="Notify"/>
<bpmn:sequenceFlow id="F_Notify_End" sourceRef="Notify" targetRef="End"/>
<bpmn:textAnnotation id="N_Overview"><bpmn:text>From sprint tickets to verified bug fixes

You pick up the active sprint&#x27;s QA tickets and an agent drafts Playwright test cases and a spec file for each one. A person approves every test PR before it is committed, and CI runs the suite on GitHub Actions. When a run fails, a second agent triages the failure and a third writes the bug report, while a person signs off on S1/S2 bugs and any triage the agent is unsure about. Bugs land in Jira and the Bug Sheet, and the team hears about it on Teams.

Note: Ask a coding agent to generate a sample Jira story with acceptance criteria and a failing results.json for testing.</bpmn:text></bpmn:textAnnotation>
<bpmn:textAnnotation id="N_Fetch"><bpmn:text>RPA (REFramework dispatcher): JQL sprint in openSprints() AND labels = QA -&gt; Queue QA_Tickets. Assets: Jira_BaseUrl, Jira_Credential. No acceptance criteria / no repo mapping -&gt; BusinessRuleException: skip + Jira comment.</bpmn:text></bpmn:textAnnotation>
<bpmn:textAnnotation id="N_Agent1"><bpmn:text>Agent 1 - Test Design &amp; Scaffold Agent (test-case-writer + browser-automation + code-review). Returns strict JSON: test_cases, spec_file, confidence.</bpmn:text></bpmn:textAnnotation>
<bpmn:textAnnotation id="N_HITL"><bpmn:text>Action Center: Approve Test PR. No auto-merge; PR stays open for human merge.</bpmn:text></bpmn:textAnnotation>
<bpmn:textAnnotation id="N_GitHub"><bpmn:text>GitHub REST via Assets GitHub_Token, GitHub_Repo. CI: workflow_dispatch -&gt; poll run -&gt; download results.json artifact.</bpmn:text></bpmn:textAnnotation>
<bpmn:textAnnotation id="N_Triage"><bpmn:text>Agent 2 (triage mode): ProductBug | TestBug | Flaky | Environment with confidence. Confidence &lt; 0.7 always goes to human review.</bpmn:text></bpmn:textAnnotation>
<bpmn:textAnnotation id="N_Bug"><bpmn:text>Agent 3 - Bug Report Agent. S1/S2 need Approve S1/S2 Bug before Jira. Sheet: Asset BugSheet_Id. No auto-close.</bpmn:text></bpmn:textAnnotation>
<bpmn:textAnnotation id="N_Errors"><bpmn:text>Errors: SystemException (API / CI / LLM) -&gt; retry 3 -&gt; escalate on Teams (Asset Teams_Channel). BusinessRuleException -&gt; skip ticket + Jira comment. No hardcoded config: Orchestrator Assets only.</bpmn:text></bpmn:textAnnotation>
<bpmn:association id="A_N_Fetch_FetchTickets" sourceRef="FetchTickets" targetRef="N_Fetch"/>
<bpmn:association id="A_N_Agent1_TestDesign" sourceRef="TestDesign" targetRef="N_Agent1"/>
<bpmn:association id="A_N_HITL_ApprovePR" sourceRef="ApprovePR" targetRef="N_HITL"/>
<bpmn:association id="A_N_GitHub_RunCI" sourceRef="RunCI" targetRef="N_GitHub"/>
<bpmn:association id="A_N_Triage_Triage" sourceRef="Triage" targetRef="N_Triage"/>
<bpmn:association id="A_N_Bug_BugReport" sourceRef="BugReport" targetRef="N_Bug"/>
<bpmn:association id="A_N_Errors_Notify" sourceRef="Notify" targetRef="N_Errors"/>
</bpmn:process>
