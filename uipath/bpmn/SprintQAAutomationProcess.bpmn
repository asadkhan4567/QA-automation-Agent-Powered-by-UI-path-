<bpmndi:BPMNEdge id="F_Start_FetchTickets_di" bpmnElement="F_Start_FetchTickets"><di:waypoint x="96" y="330.0"/><di:waypoint x="140" y="330.0"/></bpmndi:BPMNEdge>
