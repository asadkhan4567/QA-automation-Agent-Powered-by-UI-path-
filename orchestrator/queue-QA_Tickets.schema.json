{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "QA_Tickets queue item",
  "type": "object",
  "required": [
    "Reference",
    "SpecificContent"
  ],
  "properties": {
    "Reference": {
      "type": "string",
      "example": "UIP-773"
    },
    "Priority": {
      "enum": [
        "Low",
        "Normal",
        "High"
      ]
    },
    "SpecificContent": {
      "type": "object",
      "required": [
        "ticket_key",
        "summary",
        "acceptance_criteria",
        "module",
        "repo_path",
        "mode"
      ],
      "properties": {
        "ticket_key": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "acceptance_criteria": {
          "type": "string"
        },
        "module": {
          "type": "string",
          "example": "checkout"
        },
        "repo_path": {
          "type": "string",
          "example": "tests/checkout"
        },
        "sprint": {
          "type": "string"
        },
        "mode": {
          "enum": [
            "design",
            "verify"
          ]
        }
      }
    }
  }
}